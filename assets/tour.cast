[15.698433, "o", "# Cluster (9.1.1)\r\n  3 nodes  /  2 guests  /  4 storages\r\n\r\n## Nodes\r\n  pve-test-1     \u001b[32monline  \u001b[0m  cpu=  3.4%  mem=1.7 GiB / 3.8 GiB  up=32d19h\r\n  pve-test-2     \u001b[32monline  \u001b[0m  cpu=  2.6%  mem=1.7 GiB / 3.8 GiB  up=30d21h\r\n  pve-test-3     \u001b[31moffline \u001b[0m  no metrics: the node is not online\r\n\r\n## Guests\r\n  7777   lxc   alpine-existing-lxc  on pve-test-1 \u001b[32mrunning \u001b[0m 1c/512MB\r\n  8888   qemu  alpine-existing-vm   on pve-test-1 \u001b[2mstopped \u001b[0m 1c/512MB\r\n\r\n## Storages\r\n  local          dir         10.9%  on 2 nodes  (local)\r\n  local-lvm      lvmthin     13.0%  on 2 nodes  (local)\r\n  pbs-e2e        pbs          n/a  on 2 nodes  (shared)\r\n  storage        nfs         25.3%  on 2 nodes  (shared)\r\n"]
