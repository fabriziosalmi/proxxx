          Auto-allow DHCP request/reply
          
          [possible values: true, false]

      --ndp <NDP>
          Auto-allow IPv6 NDP
          
          [possible values: true, false]

      --macfilter <MACFILTER>
          Drop frames whose source MAC ≠ NIC MAC
          
          [possible values: true, false]

      --ipfilter <IPFILTER>
          Drop frames whose source IP isn't in the per-VM ipset
          
          [possible values: true, false]

      --radv <RADV>
          LXC-only: allow router advertisements
          
          [possible values: true, false]

